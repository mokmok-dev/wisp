/target
/result
/result-*
# Generated by git-hooks.nix when entering the dev shell; references Nix store
# paths and is recreated on demand, so it is intentionally not committed.
/.pre-commit-config.yaml
native/**/.build/
native/**/build/
native/**/.swiftpm/
/formal/tla/states/
/formal/tla/MC*.out
/formal/tla/SpecTE*
# Web UI build artifacts (embedded into the desktop binary at compile time;
# .gitkeep keeps `ui/dist` present so fresh checkouts compile).
apps/wisp-desktop/ui/node_modules/
apps/wisp-desktop/ui/dist/*
!apps/wisp-desktop/ui/dist/.gitkeep
